NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://daygomes.com.br

KIWIFY_WEBHOOK_TOKEN=

# Cron (Vercel envia Authorization: Bearer CRON_SECRET nas rotas agendadas)
CRON_SECRET=

# Resend (https://resend.com) — domínio daygomes.com.br verificado
RESEND_API_KEY=
EMAIL_FROM=Day Gomes <acesso@daygomes.com.br>
EMAIL_REPLY_TO=acesso@daygomes.com.br

# Cloudflare R2 (https://dash.cloudflare.com → R2 → Manage API tokens)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Limites exibidos no painel Admin → Gerenciamento (opcional; padrão = tier gratuito)
# INFRA_RESEND_DAILY_LIMIT=100
# INFRA_RESEND_MONTHLY_LIMIT=3000
# INFRA_SUPABASE_DB_LIMIT_MB=500
# INFRA_SUPABASE_STORAGE_LIMIT_MB=1024
# INFRA_R2_STORAGE_LIMIT_GB=10

# Opcional: conversão Word → PDF (Gotenberg). Se vazio, usa Chrome/Puppeteer no servidor.
# GOTENBERG_URL=https://sua-instancia-gotenberg
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
